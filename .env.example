# =========================================================
# WarrantyVault Backend Environment Variables (.env.example)
# =========================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/warrantyvault?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Comma-separated origins allowed)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Server Port
PORT=8080

# Upload Directory for Receipts
UPLOAD_DIR=uploads

# Optional Mail SMTP Settings (for warranty email alerts)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
